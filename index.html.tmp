<!-- Visitor Counter -->
<div id="visitorCounter" style="text-align:center;padding:8px;font-size:12px;color:#999;border-top:1px solid #eee;margin-top:16px;"></div>
<script>
(function(){
  var KEY='gaokao2026_visitor';
  var STAT_KEY='gaokao2026_stats';
  // Get or create unique visitor ID
  var vid=localStorage.getItem(KEY);
  if(!vid){
    vid='v'+Date.now()+'_'+Math.random().toString(36).substr(2,6);
    localStorage.setItem(KEY,vid);
  }
  // Load stats
  var stats=JSON.parse(localStorage.getItem(STAT_KEY)||'{"total":0,"visitors":[]}');
  if(stats.visitors.indexOf(vid)===-1){
    stats.visitors.push(vid);
    stats.total=stats.visitors.length;
    localStorage.setItem(STAT_KEY,JSON.stringify(stats));
  }
  var rank=stats.visitors.indexOf(vid)+1;
  var el=document.getElementById('visitorCounter');
  if(el){
    el.innerHTML='📊 你是第 <b>'+stats.total+'</b> 位访客';
  }
})();
</script>
